APP_NAME=FieldScope
DATABASE_URL=sqlite:///./data/fieldscope.db
DATA_DIR=./data
STORAGE_BACKEND=local
SEED_DEMO=true
MAX_UPLOAD_MB=80
DEVICE_INGEST_KEY=

# S3-compatible storage. Used only when STORAGE_BACKEND=s3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# RGB-only USB camera used by the Live view.
WEBCAM_ENABLED=true
WEBCAM_INDEX=0
WEBCAM_NAME=USB RGB camera
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
WEBCAM_FPS=30
WEBCAM_ZOOM=1.0
