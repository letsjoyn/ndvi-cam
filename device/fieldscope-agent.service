[Unit]
Description=FieldScope RGB and NIR capture agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fieldscope
Group=fieldscope
WorkingDirectory=/opt/fieldscope
EnvironmentFile=-/etc/fieldscope/agent.env
ExecStart=/opt/fieldscope/.venv/bin/python -m device --config /etc/fieldscope/agent.json
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
